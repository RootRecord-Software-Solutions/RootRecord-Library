{
  "schema_version": 1,
  "note": "Declared capabilities. agent_may_invoke true is only set for reads the broker can answer from the snapshot or from verify.sh. Recovery stays with the poller.",
  "capabilities": [
    {
      "id": "inspect_service",
      "description": "Read one service row from the state snapshot.",
      "kind": "read",
      "permission": "READ",
      "monitor_gate": "steps.diagnose.inspect",
      "agents": {"ava": "allowed", "bruce": "allowed", "carly": "allowed"},
      "side_effects": [],
      "agent_may_invoke": true,
      "executor": "broker-read",
      "inputs": ["service"],
      "returns": ["state", "status", "confidence"],
      "requires_confirmation": false
    },
    {
      "id": "inspect_system",
      "description": "Read host resources from the state snapshot. No hostname.",
      "kind": "read",
      "permission": "READ",
      "monitor_gate": "steps.diagnose.inspect",
      "agents": {"ava": "allowed", "bruce": "allowed", "carly": "allowed"},
      "side_effects": [],
      "agent_may_invoke": true,
      "executor": "broker-read",
      "inputs": [],
      "returns": ["cpu_percent", "mem_used_percent", "load1"],
      "requires_confirmation": false
    },
    {
      "id": "inspect_energy",
      "description": "Read pack freshness and SOC from the state snapshot.",
      "kind": "read",
      "permission": "READ",
      "monitor_gate": "steps.diagnose.inspect",
      "agents": {"ava": "allowed", "bruce": "allowed", "carly": "allowed"},
      "side_effects": [],
      "agent_may_invoke": true,
      "executor": "broker-read",
      "inputs": [],
      "returns": ["state", "soc_percent", "age_min"],
      "requires_confirmation": false
    },
    {
      "id": "inspect_npu",
      "description": "Read whether the NPU device is present.",
      "kind": "read",
      "permission": "READ",
      "monitor_gate": "steps.diagnose.inspect",
      "agents": {"ava": "allowed", "bruce": "allowed", "carly": "allowed"},
      "side_effects": [],
      "agent_may_invoke": true,
      "executor": "broker-read",
      "inputs": [],
      "returns": ["state"],
      "requires_confirmation": false
    },
    {
      "id": "inspect_relay",
      "description": "Read council relay status from the state snapshot.",
      "kind": "read",
      "permission": "READ",
      "monitor_gate": "steps.diagnose.inspect",
      "agents": {"ava": "allowed", "bruce": "allowed", "carly": "allowed"},
      "side_effects": [],
      "agent_may_invoke": true,
      "executor": "broker-read",
      "inputs": [],
      "returns": ["status", "pids", "confidence"],
      "requires_confirmation": false
    },
    {
      "id": "inspect_github_sync",
      "description": "Read whether GitHub sync is scheduled. Does not push.",
      "kind": "read",
      "permission": "READ",
      "monitor_gate": "steps.diagnose.inspect",
      "agents": {"ava": "allowed", "bruce": "allowed", "carly": "allowed"},
      "side_effects": [],
      "agent_may_invoke": true,
      "executor": "broker-read",
      "inputs": [],
      "returns": ["status", "confidence"],
      "requires_confirmation": false
    },
    {
      "id": "run_verification",
      "description": "Run verify.sh. Read-only.",
      "kind": "diagnose",
      "permission": "DIAGNOSE",
      "monitor_gate": "steps.diagnose.inspect",
      "agents": {"ava": "allowed", "bruce": "allowed", "carly": "allowed"},
      "side_effects": [],
      "agent_may_invoke": true,
      "executor": "broker-read",
      "inputs": [],
      "returns": ["lines", "exit_code"],
      "requires_confirmation": false
    },
    {
      "id": "restart_known_service",
      "description": "Respawn weather poller or council relay. Owned by the poller supervisor.",
      "kind": "recover",
      "permission": "RECOVER",
      "monitor_gate": "steps.recovery.run_existing_program",
      "agents": {"ava": "denied", "bruce": "denied", "carly": "denied"},
      "side_effects": ["process_restart"],
      "agent_may_invoke": false,
      "executor": "poller_job:service_supervisor",
      "inputs": ["service"],
      "returns": ["alive", "blocked"],
      "requires_confirmation": true,
      "why_not": {
        "kind": "gated",
        "reason": "supervise-services.sh already restarts weather and the relay, at most 3 times per 30 minutes, then BLOCKED. Agents do not call it.",
        "blocked_by": "agent_may_invoke",
        "enable_condition": "Alexander unlocks this id in the registry and the broker"
      }
    },
    {
      "id": "run_known_diagnostic",
      "description": "Supervisor dry-run. Detection only.",
      "kind": "diagnose",
      "permission": "DIAGNOSE",
      "monitor_gate": "steps.recovery.select_capability",
      "agents": {"ava": "denied", "bruce": "denied", "carly": "denied"},
      "side_effects": [],
      "agent_may_invoke": false,
      "executor": "none",
      "inputs": ["service"],
      "returns": ["alive", "would_respawn", "would_block"],
      "requires_confirmation": true,
      "why_not": {
        "kind": "not_built",
        "reason": "The dry-run exists on supervise-services.sh. The broker does not call it yet.",
        "blocked_by": "agent_may_invoke",
        "enable_condition": "a later unlock that still passes --dry-run"
      }
    },
    {
      "id": "generate_report",
      "description": "Write a report.",
      "kind": "write",
      "permission": "DIAGNOSE",
      "monitor_gate": "steps.build.execution_report",
      "agents": {"ava": "denied", "bruce": "denied", "carly": "denied"},
      "side_effects": ["writes_files"],
      "agent_may_invoke": false,
      "executor": "poller_job",
      "inputs": ["report"],
      "returns": ["path"],
      "requires_confirmation": true,
      "why_not": {
        "kind": "gated",
        "reason": "Report jobs already run on the poller. Agents do not start them.",
        "blocked_by": "agent_may_invoke",
        "enable_condition": "Alexander unlocks one named report"
      }
    },
    {
      "id": "create_work_order",
      "description": "Add a work order file.",
      "kind": "write",
      "permission": "GENERATE_WORK_ORDER",
      "monitor_gate": "steps.build.work_order_draft",
      "agents": {"ava": "denied", "bruce": "denied", "carly": "denied"},
      "side_effects": ["writes_files"],
      "agent_may_invoke": false,
      "executor": "none",
      "inputs": ["id", "target"],
      "returns": ["path"],
      "requires_confirmation": true,
      "why_not": {
        "kind": "not_built",
        "reason": "Work orders are written by a human or by Cursor. Agents do not add them.",
        "blocked_by": "agent_may_invoke",
        "enable_condition": "Alexander unlocks work-order creation"
      }
    },
    {
      "id": "development.execute_work_order",
      "description": "Hand a finalized build package to Cursor. Agents cannot invoke it.",
      "kind": "write",
      "permission": "BUILD",
      "monitor_gate": "steps.build.cursor_api",
      "agents": {"ava": "denied", "bruce": "denied", "carly": "denied"},
      "side_effects": ["writes_files"],
      "agent_may_invoke": false,
      "executor": "cursor",
      "inputs": ["request_id"],
      "returns": ["execution_report_id", "verification_report_id"],
      "requires_confirmation": true,
      "why_not": {
        "kind": "gated",
        "reason": "Build principals authorize the work order. Cursor is the executor. Agents are not build operators.",
        "blocked_by": "authorized_build_operators",
        "enable_condition": "numeric telegram id match, READY_FOR_BUILD, and the cursor_api gate"
      }
    }
  ]
}
